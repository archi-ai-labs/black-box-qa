# ============================================================
# Black-box QA Agent Dashboard — Environment Configuration
# ============================================================
# Sao chép file này thành .env và điền giá trị thật của bạn:
#   cp .env.example .env
#
# File .env sẽ KHÔNG bao giờ được commit lên git (đã có trong .gitignore)
# ============================================================

# --- Ví dụ: API Key của project bạn muốn test ---
# YOUR_PROJECT_API_KEY=your_api_key_here

# --- Ví dụ: Private key nếu test blockchain/Web3 ---
# YOUR_WALLET_PRIVATE_KEY=your_private_key_here

# --- Ví dụ: Bearer token tĩnh (nếu project dùng token cố định) ---
# YOUR_BEARER_TOKEN=your_token_here
